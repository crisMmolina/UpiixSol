# Production .env for docker compose (UPS-015). Copy to the repo root as `.env` (git-ignored) and fill in.
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use URL-safe values (token_urlsafe): POSTGRES_PASSWORD is embedded in DATABASE_URL.

POSTGRES_USER=upiixsol
POSTGRES_DB=upiixsol
POSTGRES_PASSWORD=

# >= 32 chars; the API refuses to start in prod without it.
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Public origin(s) of the site, comma-separated. Never "*".
CORS_ORIGINS=https://campus.example.org
# true behind HTTPS (production). false only for a local http test.
COOKIE_SECURE=true
RATELIMIT_ENABLED=true

# First deploy only: create the seed accounts, then set back to false and rotate them (runbook §Seed).
SEED_ON_START=false
# >= 12 chars and not the documented default; the API refuses weaker values in prod.
SEED_DEFAULT_PASSWORD=

# Where nginx listens on the host. Put TLS in front (runbook §TLS). Keep 127.0.0.1: nginx trusts
# X-Forwarded-For from this port, so it must never be reachable from outside the host.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Image tag; set to the release (e.g. 1.0.0) to keep rollbacks possible (runbook §Rollback).
APP_VERSION=latest

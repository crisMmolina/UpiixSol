# Copy to .env and fill in. Never commit .env.
ENV=dev
# dev: sqlite:///./upiixsol.db · prod: postgresql+psycopg://USER:PASSWORD@db:5432/upiixsol
DATABASE_URL=sqlite:///./upiixsol.db
# Required in prod (>= 32 chars). Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# false only for local http without localhost
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=media
RATELIMIT_ENABLED=true
# Initial password for seeded accounts (must be changed before production)
SEED_DEFAULT_PASSWORD=
# Accounts with a provisional password can only change it until they do. `false` only for a demo with the seeded accounts
REQUIRE_PASSWORD_CHANGE=true

# Email channel (spec 003). Off by default; `console` only logs counts. Never commit real keys.
MAIL_ENABLED=false
# console | mailgun. With ENV=prod, MAIL_ENABLED=true and mailgun, the three MAILGUN_* below are required
MAIL_BACKEND=console
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.upiixsol.com
# EU region: https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
# true: Mailgun accepts the call but delivers nothing
MAILGUN_TEST_MODE=false
MAIL_FROM=UpiixSol <avisos@mg.upiixsol.com>
MAIL_REPLY_TO=
# Max recipients per Mailgun billing period (Free plan: 3000 a month)
MAIL_MONTHLY_LIMIT=3000
# Day of the month (1-28, UTC) the billing period starts: see Mailgun > Billing
MAIL_PERIOD_START_DAY=1
# Comma-separated; seed accounts live on upiixsol.dev
MAIL_BLOCKED_DOMAINS=upiixsol.dev
PUBLIC_BASE_URL=https://www.upiixsol.com
